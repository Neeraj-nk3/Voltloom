{
  "name": "voltloom",
  "private": true,
  "version": "0.1.0",
  "description": "Voltloom — a browser workbench for simulating Raspberry Pi Pico circuits and running MicroPython or C firmware against them.",
  "license": "MIT",
  "author": "Neeraj Kumar",
  "type": "module",
  "workspaces": [
    "compiler"
  ],
  "engines": {
    "node": "^24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compiler": "node compiler/server.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preview": "node scripts/e2e-preview.mjs",
    "test:all": "vitest run && playwright test",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "demo": "node scripts/demo.mjs",
    "examples:build": "node scripts/build-example-projects.mjs",
    "examples:check": "node scripts/build-example-projects.mjs --check",
    "docs:screenshots": "node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5",
    "qs": "^6.16.0"
  }
}
